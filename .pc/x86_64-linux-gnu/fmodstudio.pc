prefix=/usr/local/opt
fmod_home=${prefix}/fmodstudioapi
api_home=${fmod_home}/api/studio
version=2.03.14
arch=x86_64

Name: fmodstudio
Description: FMOD Studio API
Version: ${version}
Cflags: -I${api_home}/inc
Libs: -L${api_home}/lib/${arch} -lfmodstudio
Requires.private: fmod = ${version}

Conflicts: fmodstudioL >= 2.00.00, fmodstudioL < 3.00.00

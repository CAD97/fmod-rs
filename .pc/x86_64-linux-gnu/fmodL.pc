prefix=/usr/local/opt
fmod_home=${prefix}/fmodstudioapi
api_home=${fmod_home}/api/core
version=2.03.14
arch=x86_64

Name: fmodL
Description: FMOD Core API (logging version)
Version: ${version}
Cflags: -I${api_home}/inc
Libs: -L${api_home}/lib/${arch} -lfmodL

Conflicts: fmod >= 2.00.00, fmod < 3.00.00
